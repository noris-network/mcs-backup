# restic 0.17 or newer is needed
# RESTIC_REPOSITORY_FILE names the file /run/secrets/repo: it has to exist, with the same content, where restic runs.
docker run --rm -it \
  -e RESTIC_REPOSITORY_FILE='/run/secrets/repo' \
  -e RESTIC_PASSWORD='pw' \
  -e AWS_ACCESS_KEY_ID='AKIA123' \
  -e B2_ACCOUNT_ID='b2id' \
  restic/restic
